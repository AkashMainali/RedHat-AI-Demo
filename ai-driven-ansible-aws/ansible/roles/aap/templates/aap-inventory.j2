# AAP 2.6 Containerized Growth (Single-Node) Topology Inventory
# Based on official Red Hat documentation for RHEL 10
# All passwords are injected from environment at runtime; nothing is committed to source control.
#
# Growth topology: All components (Gateway, Controller, Hub, EDA, Database, Redis) on single node.
# For production use, replace placeholder passwords and hostnames.

# Platform Gateway hosts (required in AAP 2.6)
[automationgateway]
{{ system_hostname }} ansible_connection=local ansible_host={{ control_private_ip }}

# Automation Controller hosts
[automationcontroller]
{{ system_hostname }} ansible_connection=local ansible_host={{ control_private_ip }}

# Automation Hub hosts
[automationhub]
{{ system_hostname }} ansible_connection=local ansible_host={{ control_private_ip }}

# Event-Driven Ansible controller hosts
[automationeda]
{{ system_hostname }} ansible_connection=local ansible_host={{ control_private_ip }}

# Database host (local/embedded PostgreSQL)
[database]
{{ system_hostname }} ansible_connection=local ansible_host={{ control_private_ip }}

[all:vars]
# Ansible connection
ansible_connection=local

# AAP Installer preflight check
ignore_preflight_errors=true

# PostgreSQL database (local/embedded)
postgresql_admin_username=postgres
postgresql_admin_password={{ aap_admin_password }}

# Container registry credentials (registry.redhat.io)
registry_username={{ registry_username }}
registry_password={{ registry_password }}

# Redis configuration
redis_mode=standalone

# Platform Gateway
gateway_admin_password={{ aap_admin_password }}
gateway_pg_host=localhost
gateway_pg_password={{ aap_admin_password }}

# Automation Controller
controller_admin_password={{ aap_admin_password }}
controller_pg_host=localhost
controller_pg_password={{ aap_admin_password }}
controller_percent_memory_capacity=0.5

# Automation Hub
hub_admin_password={{ aap_admin_password }}
hub_pg_host=localhost
hub_pg_password={{ aap_admin_password }}
hub_seed_collections=false

# Event-Driven Ansible
eda_admin_password={{ aap_admin_password }}
eda_pg_host=localhost
eda_pg_password={{ aap_admin_password }}

# SSL/TLS certificates
# Installer generates self-signed certificates by default (fine for demo).
# For production, provide your own certificate and key files.