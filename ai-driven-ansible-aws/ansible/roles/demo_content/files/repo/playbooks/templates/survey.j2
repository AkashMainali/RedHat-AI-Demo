{
  "name": "Prompt Lightspeed",
  "description": "Review the AI-generated prompt before generating a remediation playbook",
  "spec": [
    {
      "type": "textarea",
      "question_name": "Enter a prompt to create a remediation playbook",
      "question_description": "This prompt is sent to Ansible Lightspeed (or your own model) to generate an Ansible Playbook. Review it before launching.",
      "variable": "lightspeed_prompt",
      "required": true,
      "default": {{ human_reviewed_default | to_json }}
    },
    {
      "type": "textarea",
      "question_name": "Prompt generated by Red Hat AI (read-only reference)",
      "question_description": "Generated by the enrichment workflow. Copy it into the field above if you are happy with it - this is the human-in-the-loop checkpoint.",
      "variable": "ai_generated_prompt_reference",
      "required": false,
      "default": {{ ai_fix_instruction | to_json }}
    }
  ]
}
