# --- Terraform ---
terraform/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
terraform/terraform.tfvars
*.auto.tfvars
tfplan
*.tfplan
# NOTE: commit terraform/.terraform.lock.hcl (it pins provider versions).

# --- Secrets / keys / env (must never be committed) ---
.env
*.env
secrets.*
*.pem
*.key
id_ed25519*
id_rsa*
aiops_ansible_demo*

# --- Ansible generated at runtime ---
ansible/inventory.ini
ansible/.known_hosts
ansible/*.retry
ansible/collections/
# Extracted from the AAP setup bundle by bootstrap.sh (large, reproducible).
ansible/.aap-collections/

# --- AAP setup bundle (multi-MB, download it yourself) ---
# The directory is ansible/AAP/ (uppercase). The lowercase pattern that used to be
# here matched nothing on a case-sensitive filesystem, which is how a 3.6 MB bundle
# ended up committed. Both cases are listed now.
ansible/AAP/*.tar.gz
ansible/aap/*.tar.gz

# --- OS ---
.DS_Store
